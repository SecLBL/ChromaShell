{
  "manifest_version": 2,
  "name": "ChromaFox",
  "version": "1.0.0",
  "description": "Live browser theming from the ChromaShell color server.",
  "permissions": [
    "theme",
    "http://127.0.0.1:29847/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chromafox@chromashell"
    }
  }
}
